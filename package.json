{
  "name": "object-censor",
  "version": "1.0.0",
  "private": true,
  "description": "Browser extension that blurs images and videos until an on-device object detector has checked them, then covers detected objects with black boxes.",
  "author": "Boda Norbert",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "fetch-model": "node scripts/fetch-model.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "prebuild": "npm run fetch-model",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:content && npm run test:engine",
    "test:content": "node tests/harness/run.mjs",
    "test:engine": "node tests/harness/engine.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "playwright-core": "^1.63.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0"
  }
}
